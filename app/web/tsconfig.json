{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@ag-workbench/*": ["../vendor/antigravity-workbench/ui/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "lucide-react": ["./node_modules/lucide-react"],
      "react-markdown": ["./node_modules/react-markdown"],
      "remark-gfm": ["./node_modules/remark-gfm"],
      "remark-math": ["./node_modules/remark-math"],
      "rehype-katex": ["./node_modules/rehype-katex"],
      "rehype-highlight": ["./node_modules/rehype-highlight"],
      "mermaid": ["./node_modules/mermaid"],
      "mermaid/*": ["./node_modules/mermaid/*"],
      "next/*": ["./node_modules/next/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../vendor/antigravity-workbench/ui/src/**/*.ts",
    "../vendor/antigravity-workbench/ui/src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
