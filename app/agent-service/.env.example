# Vertex AI Configuration for Antigravity SDK Maintainer Agent
# Set to your GCP project ID (falls back to GOOGLE_CLOUD_PROJECT if unset)
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=global
# Optional explicit model override (leave blank to use Antigravity default)
AGENT_MODEL=

# Optional JSON array of default repositories to seed on first launch:
# DEFAULT_WORKSPACES_JSON='[{"id":"sample-dev","name":"Sample Agent (DEV)","path":"/path/to/dev-repo/sample-agent-service","uat_path":"/path/to/uat-repo/sample-agent-service","env":"dev"}]'
DEFAULT_WORKSPACES_JSON=

# Server settings
AGENT_SERVICE_PORT=8000
